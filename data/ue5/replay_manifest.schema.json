{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "UE5 replay manifest",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "source_export", "sequences"],
  "properties": {
    "schema_version": {"type": "string"},
    "source_export": {
      "type": "object",
      "required": ["producer", "exported_at", "provenance_note"],
      "properties": {
        "producer": {"type": "string"},
        "exported_at": {"type": "string", "format": "date-time"},
        "provenance_note": {"type": "string", "minLength": 1}
      },
      "additionalProperties": true
    },
    "sequences": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["sequence_id", "source_file", "request_count"],
        "properties": {
          "sequence_id": {"type": "string"},
          "source_file": {"type": "string"},
          "request_count": {"type": "integer", "minimum": 1},
          "sha256": {"type": "string", "pattern": "^[A-Fa-f0-9]{64}$"}
        },
        "additionalProperties": false
      }
    }
  }
}
